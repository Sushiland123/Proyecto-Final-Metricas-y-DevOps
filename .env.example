POSTGRES_USER=events
POSTGRES_DB=events_test
POSTGRES_PORT=15433
# Set all secrets before starting Compose. Never commit .env.
# Compose embeds POSTGRES_PASSWORD in DATABASE_URL: use URL-safe characters, e.g. openssl rand -hex 24.
POSTGRES_PASSWORD=
DATABASE_URL=
TEST_DATABASE_URL=
EVENT_PRODUCER_KEY=
EVENT_ANALYST_KEY=
EVENT_PRODUCER_SOURCE_KEYS=
BIND_ADDR=127.0.0.1:8000
DB_CONNECT_TIMEOUT_SECONDS=3
DB_STATEMENT_TIMEOUT_MS=5000
DB_READ_MAX_RETRIES=1
DB_READ_RETRY_BACKOFF_MS=50
