#!/bin/bash
# Escribe ~/.ssh/authorized_keys de ${admin_username} con la clave del
# administrador y las del equipo (infra/ssh/*.pub). Lo ejecuta la extensión
# CustomScript cada vez que cambia la lista. El archivo nuevo se valida antes
# del reemplazo atómico: si algo falla, el anterior queda intacto y no quedan
# temporales.
set -euo pipefail
dir=/home/${admin_username}/.ssh
install -d -m 0700 -o ${admin_username} -g ${admin_username} "$dir"
tmp="$(mktemp "$dir/authorized_keys.XXXXXX")"
trap 'rm -f "$tmp"' EXIT
cat > "$tmp" <<'CLAVES'
# administrador
${admin_key}
%{ for name, key in team_keys ~}
# ${name}
${key}
%{ endfor ~}
CLAVES
# ssh-keygen -lf omite en silencio las líneas inválidas de un archivo con
# varias claves: se exige que todas las declaradas sean válidas antes del mv.
declared="$(grep -cvE '^(#|$)' "$tmp")"
valid="$(ssh-keygen -lf "$tmp" | wc -l)"
if [ "$valid" -ne "$declared" ]; then
  echo "ERROR: $declared claves declaradas, $valid válidas; authorized_keys no cambia" >&2
  exit 1
fi
ssh-keygen -lf "$tmp"
chown ${admin_username}:${admin_username} "$tmp"
chmod 0600 "$tmp"
mv "$tmp" "$dir/authorized_keys"
